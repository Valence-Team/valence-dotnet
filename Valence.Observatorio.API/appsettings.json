{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/observatorio-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Oracle": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "valence-observatorio",
    "Audience": "valence-observatorio",
    "ExpiracaoMinutos": 120
  },
  "RabbitMq": {
    "Uri": "",
    "Fila": "valence.observatorio"
  },
  "Ibge": {
    "BaseUrl": "https://servicodados.ibge.gov.br/api/v1/",
    "TimeoutSegundos": 5
  },
  "RateLimiting": {
    "Publica": {
      "Limite": 60,
      "JanelaSegundos": 60
    },
    "Login": {
      "Limite": 5,
      "JanelaSegundos": 60
    },
    "Escrita": {
      "Limite": 20,
      "JanelaSegundos": 60
    }
  },
  "Cors": {
    "Origens": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
