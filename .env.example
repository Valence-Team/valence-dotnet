# Variáveis de ambiente do Observatório (valores fictícios)
# "__" separa seções: ConnectionStrings__Oracle equivale a ConnectionStrings:Oracle

ConnectionStrings__Oracle=Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle.fiap.com.br)(PORT=1521)))(CONNECT_DATA=(SERVER=DEDICATED)(SID=ORCL)));User Id=seu_usuario;Password=sua_senha;
Jwt__Secret=TROQUE_POR_UMA_CHAVE
Jwt__Issuer=valence-observatorio
Jwt__Audience=valence-observatorio
Jwt__ExpiracaoMinutos=120
RabbitMq__Uri=amqps://usuario:senha@host.rmq.cloudamqp.com/vhost
RabbitMq__Fila=valence.observatorio
Ibge__BaseUrl=https://servicodados.ibge.gov.br/api/v1/
Ibge__TimeoutSegundos=5
RateLimiting__Publica__Limite=60
RateLimiting__Publica__JanelaSegundos=60
RateLimiting__Login__Limite=5
RateLimiting__Login__JanelaSegundos=60
RateLimiting__Escrita__Limite=20
RateLimiting__Escrita__JanelaSegundos=60
Cors__Origens=
ApplicationInsights__ConnectionString=

# No Azure App Service, para o rate limiting enxergar o IP real do cliente
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
